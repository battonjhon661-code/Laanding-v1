ку так, чтобы изделие стало частью пространства.\u003c/p\u003e\r\n        \u003cbutton class=\"mirror-cta\"\u003e\r\n          Обсудить проект\r\n          \u003cspan class=\"mirror-cta-arrow\"\u003e\r\n            \u003csvg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"\u003e\u003cpath d=\"M5 12h14M13 5l7 7-7 7\"/\u003e\u003c/svg\u003e\r\n          \u003c/span\u003e\r\n        \u003c/button\u003e\r\n      \u003c/div\u003e\r\n    \u003c/div\u003e\r\n  \u003c/section\u003e\r\n  \u003c/div\u003e\u003c!-- /.mirror-standalone-wrap --\u003e\r\n\r\n  \u003c!-- Footer --\u003e\r\n  \u003cfooter class=\"site-footer\"\u003e\r\n    \u003cdiv class=\"site-footer__inner\"\u003e\r\n\r\n      \u003c!-- Upper: contacts (left) + FAQ (right) --\u003e\r\n      \u003cdiv class=\"site-footer__upper\"\u003e\r\n\r\n        \u003cdiv class=\"site-footer__contacts\"\u003e\r\n          \u003ca href=\"tel:+79501702345\" class=\"site-footer__phone\"\u003e+7 (950) 170-23-45\u003c/a\u003e\r\n          \u003cdiv class=\"footer-messengers\"\u003e\r\n            \u003ca href=\"https://t.me/vipglass\" class=\"footer-msg-btn\" target=\"_blank\" rel=\"noopener\"\u003e\r\n              \u003csvg viewBox=\"0 0 24 24\" fill=\"currentColor\"\u003e\r\n                \u003cpath d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.93 7.12-1.68 7.92c-.13.58-.47.72-.95.45l-2.64-1.95-1.27 1.22c-.14.14-.26.26-.54.26l.19-2.72 4.95-4.47c.22-.2-.05-.3-.34-.11L7.64 14.09l-2.59-.81c-.57-.18-.58-.57.12-.84l8.94-3.45c.47-.18.88.11.82.13z\"/\u003e\r\n              \u003c/svg\u003e\r\n              Telegram\r\n            \u003c/a\u003e\r\n            \u003ca href=\"https://max.ru/vipglass\" class=\"footer-msg-btn\" target=\"_blank\" rel=\"noopener\"\u003e\r\n              \u003csvg viewBox=\"0 0 24 24\" fill=\"currentColor\"\u003e\r\n                \u003cpath d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4 13h-1.5v-4.5l-2.5 3-2.5-3V15H8V9h1.5l2.5 3.2L14.5 9H16v6z\"/\u003e\r\n              \u003c/svg\u003e\r\n              MAX\r\n            \u003c/a\u003e\r\n          \u003c/div\u003e\r\n        \u003c/div\u003e\r\n\r\n        \u003cdiv class=\"footer-faq\"\u003e\r\n          \u003cdiv class=\"footer-faq__item\"\u003e\r\n            \u003cbutton class=\"footer-faq__q\" type=\"button\"\u003eСколько стоит изготовление?\u003c/button\u003e\r\n            \u003cdiv class=\"footer-faq__body\"\u003e\u003cdiv class=\"footer-faq__a\"\u003eСтоимость зависит от материала, площади и сложности. Точную цену рассчитываем после бесплатного замера и обсуждения проекта.\u003c/div\u003e\u003c/div\u003e\r\n          \u003c/div\u003e\r\n          \u003cdiv class=\"footer-faq__item\"\u003e\r\n            \u003cbutton class=\"footer-faq__q\" type=\"button\"\u003eКак долго изготавливается заказ?\u003c/button\u003e\r\n            \u003cdiv class=\"footer-faq__body\"\u003e\u003cdiv class=\"footer-faq__a\"\u003eСтандартный срок — 10–14 рабочих дней после подтверждения макета и оплаты. Срочные заказы обсуждаются индивидуально.\u003c/div\u003e\u003c/div\u003e\r\n          \u003c/div\u003e\r\n          \u003cdiv class=\"footer-faq__item\"\u003e\r\n            \u003cbutton class=\"footer-faq__q\" type=\"button\"\u003eРаботаете ли вы по всей России?\u003c/button\u003e\r\n            \u003cdiv class=\"footer-faq__body\"\u003e\u003cdiv class=\"footer-faq__a\"\u003eРаботаем в Санкт-Петербурге и Ленинградской области. Доставку в другие регионы организуем по согласованию.\u003c/div\u003e\u003c/div\u003e\r\n          \u003c/div\u003e\r\n          \u003cdiv class=\"footer-faq__item\"\u003e\r\n            \u003cbutton class=\"footer-faq__q\" type=\"button\"\u003eКак проходит процесс заказа?\u003c/button\u003e\r\n            \u003cdiv class=\"footer-faq__body\"\u003e\u003cdiv class=\"footer-faq__a\"\u003eЗаявка → выезд замерщика → согласование проекта и стоимости → производство → доставка и установка.\u003c/div\u003e\u003c/div\u003e\r\n      