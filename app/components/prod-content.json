: #20180c;\" data-tx=\"-60\" data-ty=\"-2\" data-rot=\"-20\" data-z=\"5\">\r\n          <div class=\"ct-art ct-art--arc\"></div>\r\n          <span class=\"ct-num\">05</span>\r\n          <span class=\"ct-label\">Скандинав</span>\r\n        </div>\r\n        <div class=\"cstack-tile\" style=\"--ct-bg: #0c1518;\" data-tx=\"60\" data-ty=\"8\" data-rot=\"17\" data-z=\"6\">\r\n          <div class=\"ct-art ct-art--diag\"></div>\r\n          <span class=\"ct-num\">06</span>\r\n          <span class=\"ct-label\">Хай-тек</span>\r\n        </div>\r\n        <div class=\"cstack-tile\" style=\"--ct-bg: #18101c;\" data-tx=\"-18\" data-ty=\"58\" data-rot=\"6\" data-z=\"7\">\r\n          <div class=\"ct-art ct-art--wave\"></div>\r\n          <span class=\"ct-num\">07</span>\r\n          <span class=\"ct-label\">Бохо</span>\r\n        </div>\r\n        <div class=\"cstack-tile\" style=\"--ct-bg: #1a1212;\" data-tx=\"22\" data-ty=\"-56\" data-rot=\"-10\" data-z=\"8\">\r\n          <div class=\"ct-art ct-art--cross\"></div>\r\n          <span class=\"ct-num\">08</span>\r\n          <span class=\"ct-label\">Ретро</span>\r\n        </div>\r\n      </div>\r\n\r\n\r\n    </div>\r\n  </section>\r\n  </div>\r\n  HIDDEN-CSTACK-END-->\r\n\r\n  <!-- Block 6: Mirror Statement -->\r\n  <div class=\"mirror-standalone-wrap\">\r\n  <section class=\"mirror-section\" id=\"mirror\">\r\n    <div class=\"mirror-inner\">\r\n      <div class=\"mirror-text\">\r\n        <p class=\"eyebrow\">Зеркала для интерьера</p>\r\n        <h2 class=\"section__title\">Наши зеркала<br>вписываются<br>в любой интерьер</h2>\r\n        <p class=\"mirror-lead\">От минимализма до классики — каждое зеркало создаётся под ваш стиль, размер и освещение. Мы подбираем форму, раму и подсветку так, чтобы изделие стало частью пространства.</p>\r\n        <button class=\"mirror-cta\">\r\n          Обсудить проект\r\n          <span class=\"mirror-cta-arrow\">\r\n            <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentCo