an\u003e\u003cspan class=\"num\"\u003e01\u003c/span\u003e\u003c/a\u003e\r\n        \u003ca href=\"#slide2\"\u003e\u003cspan\u003eО нас\u003c/span\u003e\u003cspan class=\"num\"\u003e02\u003c/span\u003e\u003c/a\u003e\r\n        \u003ca href=\"#materials\"\u003e\u003cspan\u003eМатериалы\u003c/span\u003e\u003cspan class=\"num\"\u003e03\u003c/span\u003e\u003c/a\u003e\r\n        \u003ca href=\"#projects\"\u003e\u003cspan\u003eПроекты\u003c/span\u003e\u003cspan class=\"num\"\u003e04\u003c/span\u003e\u003c/a\u003e\r\n        \u003ca href=\"#mirror\"\u003e\u003cspan\u003eЗеркала\u003c/span\u003e\u003cspan class=\"num\"\u003e05\u003c/span\u003e\u003c/a\u003e\r\n        \u003ca href=\"#\"\u003e\u003cspan\u003eКонтакты\u003c/span\u003e\u003cspan class=\"num\"\u003e06\u003c/span\u003e\u003c/a\u003e\r\n      \u003c/nav\u003e\r\n      \u003cdiv class=\"nav-sheet__foot\"\u003e\r\n        \u003cspan\u003eСвязаться\u003c/span\u003e\r\n        \u003ca href=\"tel:+79501702345\"\u003e+7 (950) 170-23-45\u003c/a\u003e\r\n      \u003c/div\u003e\r\n    \u003c/div\u003e\r\n  \u003c/div\u003e\r\n\r\n  \u003cdiv class=\"parallax-stack\"\u003e\r\n  \u003c!-- Block 2: Slide 2 --\u003e\r\n  \u003cdiv id=\"slide2\"\u003e\r\n    \u003cdiv id=\"slide2-text\"\u003e\r\n      \u003cp class=\"s2-eyebrow\"\u003eНаша мастерская\u003c/p\u003e\r\n      \u003ch2 class=\"s2-heading\"\u003e\r\n        \u003cspan class=\"s2-line\"\u003e\u003cspan class=\"s2-li\"\u003eнаше \u003cspan class=\"s2-glass\"\u003eСтекло\u003c/span\u003e\u003c/span\u003e\u003c/span\u003e\r\n        \u003cspan class=\"s2-line\"\u003e\u003cspan class=\"s2-li\"\u003eсоздаёт\u003c/span\u003e\u003c/span\u003e\r\n        \u003cspan class=\"s2-line\"\u003e\u003cspan class=\"s2-li\"\u003eпространство и уют.\u003c/span\u003e\u003c/span\u003e\r\n      \u003c/h2\u003e\r\n      \u003cp class=\"s2-sub\"\u003eСовременные решения из стекла, заполняющие интерьер светом, воздухом и чистотой.\u003c/p\u003e\r\n    \u003c/div\u003e\r\n  \u003c/div\u003e\r\n\r\n  \u003c!-- Materials Block --\u003e\r\n  \u003csection class=\"mat-block\" id=\"materials\"\u003e\r\n    \u003cdiv class=\"mat-stage\" id=\"mat-stage\"\u003e\r\n      \u003cdiv class=\"mat-page\"\u003e\r\n\r\n        \u003cdiv class=\"mat-backdrop\"\u003e\u003cdiv class=\"mat-grain\"\u003e\u003c/div\u003e\u003c/div\u003e\r\n        \u003cdiv class=\"mat-hero-slot\"\u003e\u003c/div\u003e\r\n        \u003cdiv class=\"mat-cabinet-shadow\"\u003e\u003c/div\u003e\r\n\r\n        \u003cdiv class=\"mat-left-col\"\u003e\r\n          \u003cdiv class=\"mat-crumb\"\u003e/ Материалы\u003c/div\u003e\r\n          \u003ch2 class=\"mat-h1\"\u003eКачество\u003cbr/\u003eв каждой\u003cbr/\u003eдетали\u003c/h2\u003e\r\n          \u003cp class=\"mat-lead\"\u003e\r\n            Мы тщательно подбираем материалы\u003cbr/\u003e\r\n            и комплектующие, чтобы каждая деталь\u003cbr/\u003e\r\n            служила долго и выглядела безупречно.\r\n          \u003c/p\u003e\r\n          \u003cdiv class=\"mat-hint\"\u003e\r\n            \u003cspan class=\"mat-cursor\"\u003e\r\n              \u003csvg viewBox=\"0 0 24 24\" fill=\"currentColor\"\u003e\r\n                \u003cpath d=\"M5 3 L5 18 L9.2 14.4 L11.6 20.4 L14 19.3 L11.6 13.6 L17 13.6 Z\"\r\n                      stroke=\"#0c0c0d\" stroke-width=\".6\" stroke-linejoin=\"round\"/\u003e\r\n              \u003c/svg\u003e\r\n            \u003c/span\u003e\r\n            Наведите на ячейку\u003cbr/\u003eдля детального просмотра\r\n          \u003c/div\u003e\r\n        \u003c/div\u003e\r\n\r\n\u003cdiv class=\"mat-cabinet\" id=\"mat-cabinet\"\u003e\r\n\r\n          \u003c!-- ROW 1 --\u003e\r\n          \u003cdiv class=\"mat-row\" data-row=\"0\"\u003e\r\n            \u003cdiv class=\"mat-row-label\"\u003eЗеркала\u003c/div\u003e\r\n            \u003cbutton class=\"mat-row-arrow prev\" aria-label=\"Previous\"\u003e\u003csvg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"\u003e\u003cpath d=\"M15 6l-6 6 6 6\"/